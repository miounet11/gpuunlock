post_install() {
  cat <<'EOF'
==> gpu_unlock now loads ahead of nvidia on every boot but does nothing until
==> you opt in on the kernel command line:
==>   gpu_unlock.targets=all              every unbound RTX 3090
==>   gpu_unlock.targets=0000:21:00.0     only these PCI addresses (comma-separated)
==> Remove the option in your bootloader to boot without the unlock.
==> See /usr/share/doc/gpu-unlock/README.md.
EOF
}
